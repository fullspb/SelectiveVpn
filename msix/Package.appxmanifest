<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  IgnorableNamespaces="uap rescap desktop6">

  <!-- Partner Center → Selective VPN → Product identity -->
  <Identity
    Name="Fulllspb.SelectiveVPN"
    Publisher="CN=8A6C2957-1AEA-4484-8C16-17406AAD7BDC"
    Version="0.1.10.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Selective VPN</DisplayName>
    <PublisherDisplayName>Fulllspb</PublisherDisplayName>
    <Description>Selective VPN client for Windows: route chosen apps through Mihomo and AmneziaWG.</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="ru-ru" />
    <Resource Language="es-es" />
    <Resource Language="pt-br" />
    <Resource Language="zh-cn" />
  </Resources>

  <Applications>
    <Application
      Id="App"
      Executable="SelectiveVpn.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Selective VPN"
        Description="Selective VPN client: only chosen apps, folders, or addresses go through the tunnel."
        BackgroundColor="#0F172A"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png"
          ShortName="Selective VPN" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#0F172A" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Full-trust Win32 / WPF desktop app with child Mihomo process and optional UAC elevation for TUN.
         Store submission still requires Microsoft approval for these restricted capabilities. -->
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="allowElevation" />
  </Capabilities>
</Package>
