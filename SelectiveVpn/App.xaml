<Application x:Class="SelectiveVpn.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#F3F5F8"/>
        <SolidColorBrush x:Key="WindowForeground" Color="#1C2430"/>
        <SolidColorBrush x:Key="MutedForeground" Color="#5C677A"/>
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorder" Color="#E2E6ED"/>
        <SolidColorBrush x:Key="Accent" Color="#1F4E8C"/>
        <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ButtonForeground" Color="#1C2430"/>
        <SolidColorBrush x:Key="ButtonBorder" Color="#D0D5DD"/>
        <SolidColorBrush x:Key="PrimaryBackground" Color="#1F4E8C"/>
        <SolidColorBrush x:Key="PrimaryForeground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PrimaryBorder" Color="#173E70"/>
        <SolidColorBrush x:Key="FieldBackground" Color="#F7F8FA"/>
        <SolidColorBrush x:Key="FieldBorder" Color="#E2E6ED"/>
        <SolidColorBrush x:Key="InfoBackground" Color="#F3F7FC"/>
        <SolidColorBrush x:Key="InfoBorder" Color="#D6E2F5"/>
        <SolidColorBrush x:Key="InfoForeground" Color="#1F4E8C"/>
        <SolidColorBrush x:Key="EmptyForeground" Color="#8B95A5"/>
        <SolidColorBrush x:Key="PathForeground" Color="#667085"/>
        <SolidColorBrush x:Key="StatusIdleBackground" Color="#FFF7EB"/>
        <SolidColorBrush x:Key="StatusIdleBorder" Color="#F5D7A8"/>
        <SolidColorBrush x:Key="StatusIdleForeground" Color="#8A5A00"/>
        <SolidColorBrush x:Key="StatusConnectedBackground" Color="#E8F6EE"/>
        <SolidColorBrush x:Key="StatusConnectedBorder" Color="#B7E0C6"/>
        <SolidColorBrush x:Key="StatusConnectedForeground" Color="#1F7A45"/>
        <SolidColorBrush x:Key="StatusConnectingBackground" Color="#EEF3FA"/>
        <SolidColorBrush x:Key="StatusConnectingBorder" Color="#D3DDED"/>
        <SolidColorBrush x:Key="StatusConnectingForeground" Color="#1F4E8C"/>
        <SolidColorBrush x:Key="StatusErrorBackground" Color="#FDECEC"/>
        <SolidColorBrush x:Key="StatusErrorBorder" Color="#F3C1C1"/>
        <SolidColorBrush x:Key="StatusErrorForeground" Color="#A33B3B"/>
        <SolidColorBrush x:Key="SidebarBackground" Color="#F7F8FB"/>
        <SolidColorBrush x:Key="SidebarBorder" Color="#E2E6ED"/>
        <SolidColorBrush x:Key="NavActiveBackground" Color="#E8EEF8"/>
        <SolidColorBrush x:Key="NavActiveForeground" Color="#1F4E8C"/>
        <SolidColorBrush x:Key="ListHoverBackground" Color="#E4EAF3"/>
        <SolidColorBrush x:Key="ListSelectedBackground" Color="#D3E3FA"/>
        <SolidColorBrush x:Key="DangerForeground" Color="#C24141"/>
        <SolidColorBrush x:Key="DangerBackground" Color="#C24141"/>
        <SolidColorBrush x:Key="DangerBorder" Color="#9A3030"/>
        <SolidColorBrush x:Key="EyebrowForeground" Color="#5B6B8A"/>

        <Style x:Key="ThemedScrollBarThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bd"
                                Background="{DynamicResource MutedForeground}"
                                CornerRadius="6"
                                Margin="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemedScrollBarPageButton" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="ThemedVerticalScrollBar" TargetType="ScrollBar">
            <Grid Background="{DynamicResource CardBorder}">
                <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False"
                       ViewportSize="NaN">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ThemedScrollBarPageButton}" Command="ScrollBar.PageUpCommand"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ThemedScrollBarThumb}"
                               MinHeight="48" Width="14" HorizontalAlignment="Center"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ThemedScrollBarPageButton}" Command="ScrollBar.PageDownCommand"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>

        <ControlTemplate x:Key="ThemedHorizontalScrollBar" TargetType="ScrollBar">
            <Grid Background="{DynamicResource CardBorder}">
                <Track x:Name="PART_Track" Focusable="False" ViewportSize="NaN">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ThemedScrollBarPageButton}" Command="ScrollBar.PageLeftCommand"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ThemedScrollBarThumb}"
                               MinWidth="48" Height="14" VerticalAlignment="Center"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ThemedScrollBarPageButton}" Command="ScrollBar.PageRightCommand"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>

        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="MinWidth" Value="16"/>
            <Setter Property="Template" Value="{StaticResource ThemedVerticalScrollBar}"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="16"/>
                    <Setter Property="MinHeight" Value="16"/>
                    <Setter Property="Template" Value="{StaticResource ThemedHorizontalScrollBar}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
