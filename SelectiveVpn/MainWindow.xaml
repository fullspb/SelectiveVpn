<Window x:Class="SelectiveVpn.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SelectiveVpn"
        Icon="pack://application:,,,/Assets/SelectiveVpn.ico"
        Height="860"
        Width="1120"
        MinHeight="860"
        MinWidth="1120"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        FontFamily="Segoe UI"
        Foreground="{DynamicResource WindowForeground}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        d:DesignHeight="860"
        d:DesignWidth="1120">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Track" Width="36" Height="20" CornerRadius="10" VerticalAlignment="Center"
                                    Background="{DynamicResource ButtonBackground}"
                                    BorderBrush="{DynamicResource ButtonBorder}" BorderThickness="1">
                                <Ellipse x:Name="Knob" Width="14" Height="14" HorizontalAlignment="Left" Margin="2,0,0,0"
                                         Fill="{DynamicResource MutedForeground}"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource PrimaryBackground}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource PrimaryBorder}"/>
                                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource PrimaryForeground}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedForeground}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForeground}"/>
            <Setter Property="Margin" Value="10,0,0,8"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
            <Setter Property="Background" Value="{DynamicResource PrimaryBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBorder}"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="{DynamicResource DangerBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBorder}"/>
        </Style>

        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="ThemeChoice" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="2,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden"/>
        </Style>

        <Style x:Key="StretchListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border x:Name="Accent" Width="3" HorizontalAlignment="Left" Margin="-8,0,0,0"
                                        CornerRadius="2" Background="Transparent"/>
                                <ContentPresenter/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ListHoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ListSelectedBackground}"/>
                                <Setter TargetName="Accent" Property="Background" Value="{DynamicResource PrimaryBackground}"/>
                                <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Viewbox Stretch="Uniform">
    <Grid Width="1120" Height="860" TextOptions.TextFormattingMode="Ideal">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBackground}"
                BorderBrush="{DynamicResource SidebarBorder}"
                BorderThickness="0,0,1,0"
                Padding="12,16,12,14">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Margin="6,0,0,8" Style="{StaticResource SectionLabel}" Text="ПРОФИЛИ"/>

                <Border DockPanel.Dock="Bottom" Margin="2,10,2,0" Padding="10,8" CornerRadius="10"
                        Background="{DynamicResource FieldBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Входящий" FontSize="10" Foreground="{DynamicResource MutedForeground}"/>
                            <TextBlock Margin="0,2,0,0" Text="{Binding IncomingTraffic}" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Исходящий" FontSize="10" Foreground="{DynamicResource MutedForeground}"/>
                            <TextBlock Margin="0,2,0,0" Text="{Binding OutgoingTraffic}" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Button DockPanel.Dock="Bottom"
                        Content="Настройки"
                        Style="{StaticResource ActionButton}"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Margin="2,8,2,0"
                        Command="{Binding OpenSettingsCommand}"/>

                <Button DockPanel.Dock="Bottom"
                        Content="Добавить профиль"
                        Style="{StaticResource PrimaryButton}"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Margin="2,8,2,0"
                        Command="{Binding BrowseConfigCommand}"/>

                <Button DockPanel.Dock="Bottom"
                        Content="Добавить по ссылке"
                        Style="{StaticResource ActionButton}"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Margin="2,8,2,0"
                        Command="{Binding ImportSubscriptionCommand}"/>

                <UniformGrid DockPanel.Dock="Bottom" Columns="3" Margin="0,8,0,0">
                    <Button Content="Светлая" Command="{Binding UseLightThemeCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ThemeChoice}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ThemeId}" Value="light">
                                        <Setter Property="Background" Value="{DynamicResource NavActiveBackground}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource NavActiveForeground}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Тёмная" Command="{Binding UseDarkThemeCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ThemeChoice}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ThemeId}" Value="dark">
                                        <Setter Property="Background" Value="{DynamicResource NavActiveBackground}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource NavActiveForeground}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Зелёная" Command="{Binding UseGreenThemeCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ThemeChoice}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ThemeId}" Value="green">
                                        <Setter Property="Background" Value="{DynamicResource NavActiveBackground}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource NavActiveForeground}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="OLED" Command="{Binding UseOledThemeCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ThemeChoice}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ThemeId}" Value="oled">
                                        <Setter Property="Background" Value="{DynamicResource NavActiveBackground}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource NavActiveForeground}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Янтарь" Command="{Binding UseAmberThemeCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ThemeChoice}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ThemeId}" Value="amber">
                                        <Setter Property="Background" Value="{DynamicResource NavActiveBackground}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource NavActiveForeground}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Индиго" Command="{Binding UseIndigoThemeCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ThemeChoice}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ThemeId}" Value="indigo">
                                        <Setter Property="Background" Value="{DynamicResource NavActiveBackground}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource NavActiveForeground}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </UniformGrid>

                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Profiles}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,1"
                                        ToolTip="{Binding ConfigPath}"
                                        Command="{Binding DataContext.SelectProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource NavActiveBackground}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource NavActiveForeground}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <DockPanel>
                                        <Grid Width="14" Height="14" Margin="0,0,8,0" DockPanel.Dock="Left" VerticalAlignment="Center">
                                            <Ellipse Width="14" Height="14" Opacity="0.28">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#FF4D4F"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                <Setter Property="Fill" Value="#3DDC97"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <Ellipse Width="8" Height="8">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#FF4D4F"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                <Setter Property="Fill" Value="#3DDC97"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </Grid>
                                        <Border Width="3" Margin="0,2,8,2" CornerRadius="2" DockPanel.Dock="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource PrimaryBackground}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="28,22,28,8">
            <StackPanel MaxWidth="920" HorizontalAlignment="Stretch">
                <TextBlock Margin="0,0,0,16" Text="{Binding ProfileName}" FontSize="26" FontWeight="SemiBold"/>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="3" Height="16" CornerRadius="2" Margin="0,0,10,0"
                                    Background="{DynamicResource PrimaryBackground}" VerticalAlignment="Center"/>
                            <Border DockPanel.Dock="Right" CornerRadius="10" Padding="8,3" BorderThickness="1" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource StatusIdleBackground}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource StatusIdleBorder}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusKind}" Value="connected">
                                                <Setter Property="Background" Value="{DynamicResource StatusConnectedBackground}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource StatusConnectedBorder}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusKind}" Value="connecting">
                                                <Setter Property="Background" Value="{DynamicResource StatusConnectingBackground}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource StatusConnectingBorder}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusKind}" Value="error">
                                                <Setter Property="Background" Value="{DynamicResource StatusErrorBackground}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource StatusErrorBorder}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource StatusIdleForeground}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatusKind}" Value="connected">
                                                        <Setter Property="Fill" Value="{DynamicResource StatusConnectedForeground}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusKind}" Value="connecting">
                                                        <Setter Property="Fill" Value="{DynamicResource StatusConnectingForeground}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusKind}" Value="error">
                                                        <Setter Property="Fill" Value="{DynamicResource StatusErrorForeground}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding StatusText}" FontSize="12" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource StatusIdleForeground}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatusKind}" Value="connected">
                                                        <Setter Property="Foreground" Value="{DynamicResource StatusConnectedForeground}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusKind}" Value="connecting">
                                                        <Setter Property="Foreground" Value="{DynamicResource StatusConnectingForeground}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusKind}" Value="error">
                                                        <Setter Property="Foreground" Value="{DynamicResource StatusErrorForeground}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Подключение" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Состояние" Foreground="{DynamicResource MutedForeground}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding StatusDetail}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Внешний IP" Foreground="{DynamicResource MutedForeground}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ExternalIp}" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{DynamicResource DangerForeground}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ConnectedServer}" FontSize="14"
                                           Foreground="{DynamicResource MutedForeground}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Margin="12,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ConnectedServer}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="2" Content="Обновить" Style="{StaticResource ActionButton}"
                                    Command="{Binding RefreshIpCommand}" Margin="12,0,0,0"/>
                        </Grid>
                        <TextBlock Margin="140,4,0,0" Style="{StaticResource Hint}" Text="{Binding IpCaption}"/>

                        <WrapPanel Margin="0,16,0,0">
                            <Button Content="Запустить" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding ConnectCommand}" Margin="0,0,8,8"/>
                            <Button Content="Остановить" Style="{StaticResource ActionButton}"
                                    Command="{Binding DisconnectCommand}" Margin="0,0,8,8"/>
                            <Button Content="Серверы"
                                    Command="{Binding ManageServersCommand}" Margin="0,0,8,8">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSubscriptionProfile}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Редактировать"
                                    Command="{Binding EditConfigCommand}" Margin="0,0,8,8">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWireGuardProfile}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Убрать профиль" Style="{StaticResource DangerButton}"
                                    Command="{Binding RemoveProfileCommand}" Margin="0,0,8,8"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="3" Height="16" CornerRadius="2" Margin="0,0,10,0"
                                    Background="{DynamicResource PrimaryBackground}" VerticalAlignment="Center"/>
                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource MutedForeground}">
                                <Run Text="{Binding TargetCount, Mode=OneWay}"/>
                                <Run Text=" в списке"/>
                            </TextBlock>
                            <TextBlock Text="Приложения через VPN" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Margin="0,8,0,10" Style="{StaticResource Hint}" Text="{Binding AppsHint}"/>
                        <CheckBox Margin="0,0,0,12" Style="{StaticResource Switch}"
                                  Content="Всё через VPN, кроме списка"
                                  IsChecked="{Binding ExceptListed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEnabled="{Binding HasProfile}"/>

                        <Border Background="{DynamicResource FieldBackground}" CornerRadius="8" Padding="4" MinHeight="72">
                            <Grid>
                                <ListBox x:Name="AppList"
                                         ItemsSource="{Binding Apps}"
                                         SelectedItem="{Binding SelectedApp}"
                                         ItemContainerStyle="{StaticResource StretchListItem}"
                                         MaxHeight="220">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding KindLabel}" FontSize="11"
                                                           Foreground="{DynamicResource MutedForeground}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding DetailText}" FontSize="11"
                                                               Foreground="{DynamicResource PathForeground}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="Список пуст"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource EmptyForeground}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasApps}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="Добавить приложение" Style="{StaticResource ActionButton}"
                                    Command="{Binding AddAppCommand}" Margin="0,0,8,0"/>
                            <Button Content="Добавить папку" Style="{StaticResource ActionButton}"
                                    Command="{Binding AddFolderCommand}" Margin="0,0,8,0"/>
                            <Button Content="Добавить список" Style="{StaticResource ActionButton}"
                                    Command="{Binding AddAddressListCommand}" Margin="0,0,8,0"/>
                            <Button Content="Редактировать"
                                    Command="{Binding EditAddressListCommand}"
                                    Margin="0,0,8,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanEditAddressList}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Удалить" Style="{StaticResource DangerButton}"
                                    Command="{Binding RemoveCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0">
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="3" Height="16" CornerRadius="2" Margin="0,0,10,0"
                                    Background="{DynamicResource PrimaryBackground}" VerticalAlignment="Center"/>
                            <TextBlock Text="Журнал" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Border Margin="0,10,0,0" Background="{DynamicResource FieldBackground}" CornerRadius="8" Padding="4">
                            <ListBox x:Name="EventLogList"
                                     Height="132"
                                     ItemsSource="{Binding LogEntries}"
                                     DisplayMemberPath="Display"
                                     ItemContainerStyle="{StaticResource StretchListItem}"
                                     FontSize="12"/>
                        </Border>
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource Hint}" Text="{Binding AppsFooter}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

            <TextBlock Grid.Row="1"
                       Margin="0,0,20,8"
                       HorizontalAlignment="Right"
                       FontSize="11"
                       Foreground="{DynamicResource MutedForeground}"
                       Text="{Binding VersionLabel}"/>
        </Grid>
    </Grid>
    </Viewbox>
</Window>
