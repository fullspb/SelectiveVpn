<Window x:Class="SelectiveVpn.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:SelectiveVpn.Controls"
        xmlns:services="clr-namespace:SelectiveVpn.Services"
        mc:Ignorable="d" Title="SelectiveVPN"
        Icon="pack://application:,,,/Assets/SelectiveVpn.ico"
        Width="1140" Height="830"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource WindowForeground}"
        FontFamily="{DynamicResource ThemeFontFamily}" services:ThemeChrome.IsRetro="{DynamicResource IsRetroTheme}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" d:DesignWidth="1140" d:DesignHeight="830">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanVisibility"/>
        <services:CountryFlagConverter x:Key="CountryFlagImage"/>

        <!-- ============================================================ shared bits -->
        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForeground}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForeground}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="ErrorDetail" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DangerForeground}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding StatusKind}" Value="error"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="EmptyHint" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
            <Style.Triggers><DataTrigger Binding="{Binding HasApps}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="NewProfileAction" TargetType="Button" BasedOn="{StaticResource OrbitTextButton}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding HasProfile}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="BusyList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <!-- Own template: the stock ListBox one paints a white background while disabled. -->
            <Setter Property="Template" Value="{StaticResource OrbitListBoxTemplate}"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="OrbitContextMenu" TargetType="ContextMenu" BasedOn="{StaticResource {x:Type ContextMenu}}">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="MinWidth" Value="225"/>
        </Style>
        <ContextMenu x:Key="ImportProfileMenu" x:Shared="False" Style="{StaticResource OrbitContextMenu}">
            <MenuItem Header="{DynamicResource Orbit.FromFile}" Command="{Binding BrowseConfigCommand}" Style="{StaticResource OrbitMenuItem}"/>
            <MenuItem Header="{DynamicResource Orbit.ByLink}" Command="{Binding ImportSubscriptionCommand}" Style="{StaticResource OrbitMenuItem}"/>
        </ContextMenu>
        <ContextMenu x:Key="AddRuleMenu" x:Shared="False" Style="{StaticResource OrbitContextMenu}">
            <MenuItem Header="{DynamicResource Ui.AddApp}" Command="{Binding AddAppCommand}" Style="{StaticResource OrbitMenuItem}"/>
            <MenuItem Header="{DynamicResource Ui.AddFolder}" Command="{Binding AddFolderCommand}" Style="{StaticResource OrbitMenuItem}"/>
            <MenuItem Header="{DynamicResource Ui.AddList}" Command="{Binding AddAddressListCommand}" Style="{StaticResource OrbitMenuItem}"/>
        </ContextMenu>
        <ContextMenu x:Key="ProfileMenu" x:Shared="False" Style="{StaticResource OrbitContextMenu}">
            <MenuItem Header="{DynamicResource Orbit.Configuration}" Command="{Binding EditConfigCommand}" Style="{StaticResource OrbitMenuItem}"/>
            <MenuItem Header="{DynamicResource Orbit.ManageServers}" Command="{Binding ManageServersCommand}" Style="{StaticResource OrbitMenuItem}"/>
            <MenuItem Header="{DynamicResource Orbit.Advanced}" Style="{StaticResource OrbitMenuItem}">
                <MenuItem Header="{DynamicResource Orbit.CheckConfig}" Command="{Binding CheckConfigCommand}" Style="{StaticResource OrbitMenuItem}"/>
                <MenuItem Header="{DynamicResource Orbit.BrowseEngine}" Command="{Binding BrowseEngineCommand}" Style="{StaticResource OrbitMenuItem}" ToolTip="{Binding EngineLabel}"/>
            </MenuItem>
            <Separator/>
            <MenuItem Header="{DynamicResource Ui.RemoveProfile}" Command="{Binding RemoveProfileCommand}" Style="{StaticResource OrbitMenuItem}" Foreground="{DynamicResource DangerForeground}"/>
        </ContextMenu>

        <!-- Rule kind glyph (application / folder / address list). -->
        <DataTemplate x:Key="RuleGlyph">
            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="&#xE737;"/><Style.Triggers>
                    <DataTrigger Binding="{Binding EffectiveKind}" Value="Folder"><Setter Property="Text" Value="&#xE8B7;"/></DataTrigger>
                    <DataTrigger Binding="{Binding IsAddressList}" Value="True"><Setter Property="Text" Value="&#xE8FD;"/></DataTrigger>
                </Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
        </DataTemplate>

        <Style x:Key="RuleActionButton" TargetType="Button" BasedOn="{StaticResource OrbitIconButton}">
            <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="4"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Generic rounded button with soft fill. -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
            <Setter Property="Background" Value="#0FFFFFFF"/>
            <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="14,0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.75"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>

        <!-- Clickable 3D scene (globe / tunnel / coin). -->
        <Style x:Key="HeroButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="HeroRoot" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                        <controls:ThemeHero x:Name="Hero" StatusKind="{Binding StatusKind}"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HeroRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.03" Duration="0:0:0.35"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="HeroRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.03" Duration="0:0:0.35"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                            </Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HeroRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.3"/>
                                <DoubleAnimation Storyboard.TargetName="HeroRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.3"/>
                            </Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Hero" Property="Opacity" Value="0.8"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="HeroRoot" Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>

        <!-- Physical push button: a face that rides on a darker edge. -->
        <Style x:Key="PushButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
            <Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Height" Value="64"/><Setter Property="Width" Value="260"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Background="Black" Opacity="0.45" CornerRadius="{DynamicResource PushButtonCornerRadius}" Margin="2,12,2,-4">
                            <Border.Effect><BlurEffect Radius="12"/></Border.Effect>
                        </Border>
                        <Border Background="{DynamicResource PrimaryEdge}" CornerRadius="{DynamicResource PushButtonCornerRadius}" Margin="0,8,0,0"/>
                        <Border x:Name="PushFace" Background="{DynamicResource PushBackground}" CornerRadius="{DynamicResource PushButtonCornerRadius}" Margin="0,0,0,8" BorderBrush="{DynamicResource WindowForeground}" BorderThickness="0">
                            <Border.RenderTransform><TranslateTransform X="0" Y="0"/></Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,0"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="PushFace" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-3" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.8"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="PushFace" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="PushFace" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="6" Duration="0:0:0.05"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="PushFace" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.9"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="PushFace" Property="BorderThickness" Value="2"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>

        <!-- Segmented routing mode switch (TabControl so keyboard and automation keep working). -->
        <Style x:Key="SegmentTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource MutedForeground}"/>
            <Setter Property="FontSize" Value="12.5"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HeaderTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"/></DataTemplate></Setter.Value></Setter>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Seg" Margin="2" MinHeight="44" Padding="10,6" CornerRadius="11" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Seg" Property="Background" Value="#14FFFFFF"/></Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Seg" Property="Background" Value="{DynamicResource OrbitAccentSoftBackground}"/>
                            <Setter TargetName="Seg" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Seg" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="SegmentTabs" TargetType="TabControl">
            <Setter Property="ItemContainerStyle" Value="{StaticResource SegmentTab}"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Border Background="#40000000" CornerRadius="14" Padding="3">
                        <UniformGrid Rows="1" IsItemsHost="True" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Contained"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value></Setter>
            <Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers>
        </Style>

        <!-- Packets running along a route lane. -->
        <Storyboard x:Key="LaneRun" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="P1" Storyboard.TargetProperty="(Canvas.Left)" From="-30" To="320" Duration="0:0:2.4"/>
            <DoubleAnimation Storyboard.TargetName="P2" Storyboard.TargetProperty="(Canvas.Left)" From="-30" To="320" Duration="0:0:2.4" BeginTime="0:0:0.8"/>
            <DoubleAnimation Storyboard.TargetName="P3" Storyboard.TargetProperty="(Canvas.Left)" From="-30" To="320" Duration="0:0:2.4" BeginTime="0:0:1.6"/>
        </Storyboard>

        <!-- ============================================================ ORBIT -->
        <Style x:Key="OrbitGlass" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
                        <GradientStop Color="#1EFFFFFF" Offset="0"/><GradientStop Color="#08FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#17FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="22"/>
        </Style>
        <Style x:Key="OrbitPlate" TargetType="Border">
            <Setter Property="Background" Value="#33080B18"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="40" ShadowDepth="18" Direction="270" Opacity="0.6" Color="Black"/></Setter.Value></Setter>
        </Style>

        <Style x:Key="OrbitProfileItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Card" CornerRadius="16" Padding="12,10" BorderThickness="1" BorderBrush="#17FFFFFF" RenderTransformOrigin="0.5,0.5">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#16FFFFFF" Offset="0"/><GradientStop Color="#06FFFFFF" Offset="1"/></LinearGradientBrush>
                        </Border.Background>
                        <Border.RenderTransform><TransformGroup><ScaleTransform/><TranslateTransform/></TransformGroup></Border.RenderTransform>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border x:Name="Avatar" Width="34" Height="34" CornerRadius="11" Background="#7FE3FF">
                                <TextBlock Text="{Binding Initial}" FontWeight="ExtraBold" FontSize="13" Foreground="#0B0E1C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" Foreground="#E8ECFF"/>
                                <TextBlock Text="{Binding KindLabel}" FontSize="11.5" Foreground="#9AA3C7" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Ellipse x:Name="RunDot" Grid.Column="2" Width="8" Height="8" Fill="#7FE3FF" VerticalAlignment="Center" Visibility="Collapsed">
                                <Ellipse.Effect><DropShadowEffect Color="#7FE3FF" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/></Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="1"><Setter TargetName="Avatar" Property="Background" Value="#B9A6FF"/></Trigger>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="2"><Setter TargetName="Avatar" Property="Background" Value="#FFC46E"/></Trigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter TargetName="RunDot" Property="Visibility" Value="Visible"/></DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" To="-2" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                            </Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" To="0" Duration="0:0:0.3"/>
                            </Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="#737FE3FF"/>
                            <Setter TargetName="Card" Property="Background">
                                <Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#2E7FE3FF" Offset="0"/><GradientStop Color="#1F8C6EFF" Offset="1"/></LinearGradientBrush></Setter.Value>
                            </Setter>
                            <Setter TargetName="Card" Property="Effect"><Setter.Value><DropShadowEffect Color="#50B4FF" BlurRadius="26" ShadowDepth="8" Direction="270" Opacity="0.55"/></Setter.Value></Setter>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#7FE3FF"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>

        <Style x:Key="OrbitRuleItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row" CornerRadius="12" Padding="10,8" Background="Transparent">
                        <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="#10FFFFFF"/>
                            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Row" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="4" Duration="0:0:0.25"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Row" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.25"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#1A7FE3FF"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <controls:AnimatedBackground x:Name="LivingBackground"/>

        <!-- ================================================================== A · ORBIT -->
        <Grid x:Name="MainBody" Margin="20,0,20,20">
            <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel LastChildFill="False" VerticalAlignment="Center">
                <Viewbox Width="22" Height="22" Margin="0,0,10,0"><Path Data="M12,3 L20,6 L20,12 C20,16.5 16.6,20.2 12,21 C7.4,20.2 4,16.5 4,12 L4,6 Z M9,12 L11,14 L15,10" Stroke="#7FE3FF" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
                <TextBlock Text="SelectiveVPN" FontWeight="ExtraBold" FontSize="14" VerticalAlignment="Center"/>
                <Border BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="10" Padding="8,1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding VersionLabel}" FontSize="11" Foreground="#8E97BD"/>
                </Border>
                <Button Content="{DynamicResource Update.BadgeTip}" Command="{Binding OpenUpdateCommand}" Style="{StaticResource OrbitTextButton}" Margin="10,0,0,0" Visibility="{Binding UpdateAvailable, Converter={StaticResource BooleanVisibility}}"/>
                <Button x:Name="LogToggleButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" MinHeight="36" Margin="0,0,10,0" Click="ToggleLogClick" ToolTip="{DynamicResource Orbit.ShowLog}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="›_" FontFamily="Consolas" Margin="0,0,8,0"/><TextBlock Text="{DynamicResource Orbit.Log}"/></StackPanel>
                </Button>
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>

                <!-- Profiles -->
                <Border Style="{StaticResource OrbitPlate}"/>
                <Border Style="{StaticResource OrbitGlass}" Padding="14,18">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="6,0,0,10">
                            <Button DockPanel.Dock="Right" Style="{StaticResource OrbitIconButton}" Width="30" Height="30" Content="⋯" FontSize="18" Click="OpenMenuClick" ContextMenu="{StaticResource ProfileMenu}" ToolTip="{DynamicResource Orbit.ProfileMenu}" AutomationProperties.Name="{DynamicResource Orbit.ProfileMenu}"/>
                            <TextBlock Text="{DynamicResource Ui.Profiles}" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" FontSize="11"/>
                        </DockPanel>
                        <StackPanel DockPanel.Dock="Bottom">
                            <Button Style="{StaticResource GhostButton}" Margin="0,8,0,0" Click="OpenMenuClick" ContextMenu="{StaticResource ImportProfileMenu}" AutomationProperties.Name="{DynamicResource Ui.AddProfile}">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="＋" Margin="0,0,8,0"/><TextBlock Text="{DynamicResource Ui.AddProfile}"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Margin="0,8,0,0" Command="{Binding OpenSettingsCommand}" AutomationProperties.Name="{DynamicResource Ui.Settings}">
                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="{DynamicResource Ui.Settings}"/></StackPanel>
                            </Button>
                        </StackPanel>
                        <ListBox Style="{StaticResource BusyList}" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" AlternationCount="3"
                                 ItemContainerStyle="{StaticResource OrbitProfileItem}" AutomationProperties.Name="{DynamicResource Ui.Profiles}" Padding="0,4,0,0"/>
                    </DockPanel>
                </Border>

                <!-- Globe -->
                <StackPanel Grid.Column="1" Margin="18,0">
                    <TextBlock Text="{DynamicResource Orbit.ConnectionEyebrow}" Style="{StaticResource Eyebrow}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding ConnectionStatusTitle}" FontSize="30" FontWeight="ExtraBold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    <TextBlock FontSize="13" Foreground="{DynamicResource MutedForeground}" HorizontalAlignment="Center" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" MaxWidth="440">
                        <TextBlock.Text><MultiBinding StringFormat="{}{0} · {1}"><Binding Path="ConnectionProfileName"/><Binding Path="ConnectionProtocol"/></MultiBinding></TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource ErrorDetail}" TextAlignment="Center" MaxWidth="420" Margin="0,6,0,0"/>
                    <Button x:Name="HeroButton" Style="{StaticResource HeroButton}" Width="360" Height="320" Margin="0,0,0,0" HorizontalAlignment="Center"
                            Command="{Binding ConnectionActionCommand}" ToolTip="{Binding ConnectionActionText}" AutomationProperties.Name="{Binding ConnectionActionText}"/>
                    <Button Style="{StaticResource PushButton}" HorizontalAlignment="Center" Command="{Binding ConnectionActionCommand}" AutomationProperties.Name="{Binding ConnectionActionText}">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18" Margin="0,0,10,0"><Path Data="M12,1 L12,11 M6,4.8 A9,9 0 1 0 18,4.8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform"/></Viewbox>
                            <TextBlock Text="{Binding ConnectionActionText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Grid Margin="0,24,0,0">
                        <Border Style="{StaticResource OrbitPlate}" CornerRadius="20"/>
                        <Border Style="{StaticResource OrbitGlass}" CornerRadius="20" Padding="22,18">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="1"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Border Grid.Column="1" Grid.RowSpan="3" Background="#17FFFFFF"/>
                                <Border Grid.Row="1" Grid.ColumnSpan="3" Background="#17FFFFFF"/>
                                <StackPanel Margin="0,0,18,16">
                                    <TextBlock Text="{DynamicResource Orbit.Server}" Style="{StaticResource Hint}"/>
                                    <DockPanel Margin="0,6,0,0">
                                        <Image x:Name="ExternalIpFlag" DockPanel.Dock="Left" Width="22" Height="15" Margin="0,0,8,0" Stretch="Uniform" VerticalAlignment="Center" Source="{Binding ExternalIpCountryCode, Converter={StaticResource CountryFlagImage}}" ToolTip="{Binding ExternalIpCountryName}">
                                            <!-- No country known: collapse, so the server name does not sit behind an empty gap. -->
                                            <Image.Style><Style TargetType="Image"><Style.Triggers><Trigger Property="Source" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></Image.Style>
                                        </Image>
                                        <TextBlock FontWeight="Bold" FontSize="15" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding ConnectedServer}"/><Setter Property="ToolTip" Value="{Binding ConnectedServer}"/><Style.Triggers>
                                                <DataTrigger Binding="{Binding ConnectedServer}" Value=""><Setter Property="Text" Value="{Binding ExternalIpCountryName}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ConnectedServer}" Value="{x:Null}"><Setter Property="Text" Value="{Binding ExternalIpCountryName}"/></DataTrigger>
                                            </Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="18,0,0,16">
                                    <TextBlock Text="{DynamicResource Orbit.ExternalIp}" Style="{StaticResource Hint}"/>
                                    <DockPanel Margin="0,6,0,0">
                                        <Button DockPanel.Dock="Right" Command="{Binding RefreshIpCommand}" Style="{StaticResource OrbitIconButton}" Width="28" Height="28" Padding="0" Margin="8,-4,0,-4" ToolTip="{DynamicResource Ui.Refresh}" AutomationProperties.Name="{DynamicResource Ui.Refresh}"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" FontSize="12"/></Button>
                                        <TextBlock x:Name="ExternalIpAddress" Text="{Binding ExternalIp}" FontWeight="Bold" FontSize="15" FontFamily="{DynamicResource ThemeMonoFontFamily}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding ExternalIp}"/>
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Margin="0,16,18,0">
                                    <TextBlock Text="{DynamicResource Orbit.ConnectionDuration}" Style="{StaticResource Hint}"/>
                                    <TextBlock x:Name="ConnectionDurationText" Text="{Binding ConnectionDuration}" FontWeight="Bold" FontSize="20" Margin="0,4,0,0" FontFamily="{DynamicResource ThemeMonoFontFamily}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2" Margin="18,16,0,0">
                                    <TextBlock Text="{DynamicResource Orbit.Traffic}" Style="{StaticResource Hint}"/>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding IncomingTraffic, StringFormat='↓ {0}'}" FontWeight="Bold" FontSize="15" Foreground="#7FE3FF" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{DynamicResource Orbit.Received}" Style="{StaticResource Hint}" FontSize="10.5" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding OutgoingTraffic, StringFormat='↑ {0}'}" FontWeight="Bold" FontSize="15" Foreground="#B9A6FF" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{DynamicResource Orbit.Sent}" Style="{StaticResource Hint}" FontSize="10.5" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button x:Name="SubscriptionServersButton" Style="{StaticResource OrbitTextButton}" Command="{Binding ManageServersCommand}" Content="{DynamicResource Orbit.ManageServers}" Visibility="{Binding IsSubscriptionProfile, Converter={StaticResource BooleanVisibility}}"/>
                        <Button Style="{StaticResource NewProfileAction}" Click="OpenMenuClick" ContextMenu="{StaticResource ImportProfileMenu}" Content="{DynamicResource Ui.AddProfile}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Routing -->
                <Border Grid.Column="2" Style="{StaticResource OrbitPlate}"/>
                <Border Grid.Column="2" Style="{StaticResource OrbitGlass}" Padding="18">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="{DynamicResource Orbit.RoutingEyebrow}" Style="{StaticResource Eyebrow}"/>
                            <TextBlock Text="{DynamicResource Orbit.RoutingTitle}" FontSize="22" FontWeight="ExtraBold" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding RulesProfileLabel}" Style="{StaticResource Hint}" Margin="0,2,0,10"/>
                            <TabControl x:Name="RoutingModeTabs" Style="{StaticResource SegmentTabs}" SelectedIndex="{Binding RoutingModeIndex, Mode=TwoWay}" AutomationProperties.Name="{DynamicResource Orbit.Mode}">
                                <TabItem Header="{DynamicResource Orbit.ModeInclude}"/>
                                <TabItem Header="{DynamicResource Orbit.ModeExclude}"/>
                            </TabControl>
                            <Border Background="{DynamicResource InfoBackground}" CornerRadius="12" Padding="12,8" Margin="0,10,0,0" Visibility="{Binding ShowRoutingNotice, Converter={StaticResource BooleanVisibility}}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Command="{Binding ReconnectCommand}" Content="{DynamicResource Orbit.Reconnect}" Style="{StaticResource OrbitTextButton}" Visibility="{Binding HasPendingChanges, Converter={StaticResource BooleanVisibility}}"/>
                                    <TextBlock Text="{Binding RoutingNotice}" TextWrapping="Wrap" Foreground="{DynamicResource InfoForeground}" FontSize="11.5" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <DockPanel Margin="4,12,4,4">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding TargetCount}" Style="{StaticResource Hint}"/>
                                <TextBlock Text="{Binding ListedRouteLabel}" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource Accent}"/>
                            </DockPanel>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom">
                            <Button x:Name="AddTargetsButton" Style="{StaticResource GhostButton}" Margin="0,6,0,0" Click="OpenMenuClick" ContextMenu="{StaticResource AddRuleMenu}" BorderBrush="#337FE3FF">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="＋" Margin="0,0,8,0"/><TextBlock Text="{DynamicResource Orbit.AddTargets}"/></StackPanel>
                            </Button>
                            <Border BorderBrush="#17FFFFFF" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,12,0,0">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="{DynamicResource Orbit.ThroughVpn}" Width="90" FontWeight="Bold" FontSize="12" Foreground="#7FE3FF" VerticalAlignment="Center"/>
                                        <Border Height="6" CornerRadius="3" Background="#267FE3FF" ClipToBounds="True">
                                            <Canvas>
                                                <Canvas.Triggers><EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard Storyboard="{StaticResource LaneRun}"/></EventTrigger></Canvas.Triggers>
                                                <Ellipse x:Name="P1" Width="8" Height="6" Fill="#7FE3FF" Canvas.Left="-30"/>
                                                <Ellipse x:Name="P2" Width="8" Height="6" Fill="#C9F4FF" Canvas.Left="-30"/>
                                                <Ellipse x:Name="P3" Width="8" Height="6" Fill="#7FE3FF" Canvas.Left="-30"/>
                                            </Canvas>
                                        </Border>
                                    </DockPanel>
                                    <DockPanel Margin="0,10,0,0">
                                        <TextBlock Text="{DynamicResource Orbit.Direct}" Width="90" FontWeight="Bold" FontSize="12" Foreground="#9AA3C7" VerticalAlignment="Center"/>
                                        <Border Height="6" CornerRadius="3" Background="#12FFFFFF" ClipToBounds="True">
                                            <Canvas>
                                                <Canvas.Triggers><EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetName="D1" Storyboard.TargetProperty="(Canvas.Left)" From="-30" To="320" Duration="0:0:3.6"/><DoubleAnimation Storyboard.TargetName="D2" Storyboard.TargetProperty="(Canvas.Left)" From="-30" To="320" Duration="0:0:3.6" BeginTime="0:0:1.8"/></Storyboard></BeginStoryboard></EventTrigger></Canvas.Triggers>
                                                <Ellipse x:Name="D1" Width="8" Height="6" Fill="#8A93B5" Canvas.Left="-30"/>
                                                <Ellipse x:Name="D2" Width="8" Height="6" Fill="#8A93B5" Canvas.Left="-30"/>
                                            </Canvas>
                                        </Border>
                                    </DockPanel>
                                    <TextBlock Text="{Binding RoutingSummary}" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <Grid>
                            <ListBox x:Name="RulesList" Style="{StaticResource BusyList}" ItemsSource="{Binding Apps}" SelectedItem="{Binding SelectedApp}" ItemContainerStyle="{StaticResource OrbitRuleItem}" AutomationProperties.Name="{DynamicResource Orbit.RoutingTitle}">
                                <ListBox.ItemTemplate><DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" CornerRadius="10" Background="#1A7FE3FF" BorderBrush="#337FE3FF" BorderThickness="1" TextElement.Foreground="#7FE3FF">
                                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RuleGlyph}" Focusable="False"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" FontWeight="Bold" FontSize="13.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding DetailText}"/>
                                            <TextBlock FontSize="11.5" Foreground="#8E97BD" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Text><MultiBinding StringFormat="{}{0} · {1}"><Binding Path="KindLabel"/><Binding Path="DetailText"/></MultiBinding></TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource RuleActionButton}" Tag="{Binding}" Click="EditRuleClick" ToolTip="{DynamicResource Orbit.EditRule}" AutomationProperties.Name="{DynamicResource Orbit.EditRule}" Visibility="{Binding IsAddressList, Converter={StaticResource BooleanVisibility}}"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70F;" FontSize="12"/></Button>
                                        <Button Grid.Column="3" Style="{StaticResource RuleActionButton}" Tag="{Binding}" Click="RemoveRuleClick" Content="×" FontSize="17" ToolTip="{DynamicResource Orbit.RemoveRule}" AutomationProperties.Name="{DynamicResource Orbit.RemoveRule}"/>
                                    </Grid>
                                </DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{DynamicResource Orbit.EmptyRules}" Style="{StaticResource EmptyHint}" Margin="4,8,4,0" VerticalAlignment="Top"/>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ================================================================== shared log overlay -->
        <Border x:Name="LogPanel" Panel.ZIndex="20" VerticalAlignment="Bottom" Height="200" Margin="40,0,40,24" Visibility="Collapsed"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="{DynamicResource CardCornerRadius}" Padding="20,12" Background="{DynamicResource CardBackground}" Effect="{DynamicResource CardEffect}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource OrbitIconButton}" Width="28" Height="28" Content="×" FontSize="16" Click="ToggleLogClick" ToolTip="{DynamicResource Orbit.HideLog}" AutomationProperties.Name="{DynamicResource Orbit.HideLog}"/>
                    <TextBlock Text="{DynamicResource Orbit.Log}" FontWeight="Bold" VerticalAlignment="Center"/>
                </DockPanel>
                <ListBox x:Name="EventLogList" ItemsSource="{Binding LogEntries}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource WindowForeground}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{DynamicResource Orbit.Log}">
                    <ListBox.ItemTemplate><DataTemplate><Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Timestamp, StringFormat=HH:mm:ss}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource MutedForeground}"/><TextBlock Grid.Column="1" Text="{Binding Message}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/></Grid></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</Window>
