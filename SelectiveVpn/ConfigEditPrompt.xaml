<Window x:Class="SelectiveVpn.ConfigEditPrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактировать конфиг"
        Width="640"
        MinWidth="520"
        MinHeight="480"
        Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource WindowForeground}"
        FontFamily="Consolas, Cascadia Mono, Segoe UI"
        UseLayoutRounding="True">
    <Border Margin="16" Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
            CornerRadius="12" Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" FontFamily="Segoe UI" Text="Редактирование WireGuard / AmneziaWG" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock x:Name="PathText" Grid.Row="1" Margin="0,8,0,0" FontFamily="Segoe UI" TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedForeground}"/>

            <TextBox x:Name="ConfigBox" Grid.Row="2" Margin="0,14,0,0"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto"
                     FontSize="13"
                     Padding="10,8"
                     Background="{DynamicResource FieldBackground}"
                     Foreground="{DynamicResource WindowForeground}"
                     BorderBrush="{DynamicResource FieldBorder}"
                     CaretBrush="{DynamicResource WindowForeground}"/>

            <TextBlock x:Name="ErrorText" Grid.Row="3" Margin="0,10,0,0" TextWrapping="Wrap" FontFamily="Segoe UI"
                       Foreground="{DynamicResource StatusErrorForeground}" Visibility="Collapsed"/>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Отмена" MinWidth="96" Margin="0,0,8,0" Padding="12,7" FontFamily="Segoe UI"
                        Click="CancelClick" IsCancel="True"
                        Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource ButtonForeground}"
                        BorderBrush="{DynamicResource ButtonBorder}"/>
                <Button Content="Сохранить" MinWidth="120" Padding="12,7" FontFamily="Segoe UI"
                        Click="SaveClick" IsDefault="True"
                        Background="{DynamicResource PrimaryBackground}" Foreground="{DynamicResource PrimaryForeground}"
                        BorderBrush="{DynamicResource PrimaryBorder}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
