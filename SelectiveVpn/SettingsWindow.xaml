<Window x:Class="SelectiveVpn.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Settings.Title}" Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource WindowForeground}"
        FontFamily="{DynamicResource ThemeFontFamily}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Border Style="{StaticResource OrbitDialogSurface}" Padding="28,25,28,24">
        <StackPanel>
            <TextBlock Text="{DynamicResource Orbit.SettingsEyebrow}" Style="{StaticResource OrbitEyebrow}"/>
            <TextBlock Style="{StaticResource OrbitDialogHeading}" Margin="0,6,0,0" Text="{DynamicResource Settings.Title}" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Margin="0,8,0,0" Text="{DynamicResource Settings.Hint}" TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedForeground}" FontSize="12"/>
            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Orbit.ColorScheme}" Foreground="{DynamicResource MutedForeground}" FontSize="11" Margin="0,0,0,7"/>
                    <ComboBox x:Name="ThemeBox" Style="{StaticResource OrbitComboBox}" DisplayMemberPath="Title" SelectedValuePath="Code" AutomationProperties.Name="{DynamicResource Orbit.ColorScheme}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource Ui.Language}" Foreground="{DynamicResource MutedForeground}" FontSize="11" Margin="0,0,0,7"/>
                    <ComboBox x:Name="LanguageBox" Style="{StaticResource OrbitComboBox}" DisplayMemberPath="Title" SelectedValuePath="Code" AutomationProperties.Name="{DynamicResource Ui.Language}"/>
                </StackPanel>
            </Grid>
            <TextBlock Margin="0,8,0,0" Text="{DynamicResource Settings.LanguageHint}" TextWrapping="Wrap" Foreground="{DynamicResource MutedForeground}" FontSize="11"/>
            <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Margin="0,23,0,0" Padding="0,19,0,0">
                <CheckBox x:Name="LaunchBox" Style="{StaticResource OrbitSwitch}">
                    <StackPanel MaxWidth="354" HorizontalAlignment="Left">
                        <TextBlock Text="{DynamicResource Settings.LaunchWithWindows}" FontSize="12" FontWeight="Medium" TextWrapping="Wrap"/>
                        <TextBlock Text="{DynamicResource Settings.LaunchHint}" Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource MutedForeground}"/>
                    </StackPanel>
                </CheckBox>
            </Border>
            <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Margin="0,19,0,0" Padding="0,19,0,0">
                <CheckBox x:Name="ConnectBox" Style="{StaticResource OrbitSwitch}">
                    <StackPanel MaxWidth="354" HorizontalAlignment="Left">
                        <TextBlock Text="{DynamicResource Settings.ConnectOnLaunch}" FontSize="12" FontWeight="Medium" TextWrapping="Wrap"/>
                        <TextBlock Text="{DynamicResource Settings.ConnectHint}" Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource MutedForeground}"/>
                    </StackPanel>
                </CheckBox>
            </Border>
            <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Margin="0,19,0,0" Padding="0,19,0,0">
                <CheckBox x:Name="AutoReconnectBox" Style="{StaticResource OrbitSwitch}" AutomationProperties.Name="{DynamicResource Settings.AutoReconnect}">
                    <StackPanel MaxWidth="354" HorizontalAlignment="Left">
                        <TextBlock Text="{DynamicResource Settings.AutoReconnect}" FontSize="12" FontWeight="Medium" TextWrapping="Wrap"/>
                        <TextBlock Text="{DynamicResource Settings.AutoReconnectHint}" Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource MutedForeground}"/>
                    </StackPanel>
                </CheckBox>
            </Border>
            <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Margin="0,25,0,0" Padding="0,18,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{DynamicResource Ui.Cancel}" MinWidth="94" Margin="0,0,8,0" Style="{StaticResource OrbitButton}" Click="CancelClick" IsCancel="True"/>
                    <Button Content="{DynamicResource Ui.Save}" MinWidth="120" Style="{StaticResource OrbitPrimaryButton}" Click="SaveClick" IsDefault="True"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
