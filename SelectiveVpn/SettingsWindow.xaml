<Window x:Class="SelectiveVpn.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource WindowForeground}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True">
    <Border Margin="20" Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
            CornerRadius="12" Padding="18">
        <StackPanel>
            <TextBlock Text="Настройки" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedForeground}"
                       Text="Автозапуск только открывает приложение. Подключение включается отдельной галочкой."/>

            <CheckBox x:Name="LaunchBox" Margin="0,16,0,0" Foreground="{DynamicResource WindowForeground}">
                <TextBlock Text="Запускать вместе с Windows" TextWrapping="Wrap"/>
            </CheckBox>
            <TextBlock Margin="22,4,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedForeground}"
                       Text="При входе в систему откроется SelectiveVpn. VPN сам не включится."/>

            <CheckBox x:Name="ConnectBox" Margin="0,14,0,0" Foreground="{DynamicResource WindowForeground}">
                <TextBlock Text="Подключаться автоматически при запуске" TextWrapping="Wrap"/>
            </CheckBox>
            <TextBlock Margin="22,4,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedForeground}"
                       Text="При каждом открытии приложения подключать выбранный профиль. Для TUN Windows запросит права администратора."/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Отмена" MinWidth="96" Margin="0,0,8,0" Padding="12,7" Click="CancelClick" IsCancel="True"
                        Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource ButtonForeground}"
                        BorderBrush="{DynamicResource ButtonBorder}"/>
                <Button Content="Сохранить" MinWidth="120" Padding="12,7" Click="SaveClick" IsDefault="True"
                        Background="{DynamicResource PrimaryBackground}" Foreground="{DynamicResource PrimaryForeground}"
                        BorderBrush="{DynamicResource PrimaryBorder}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
