<Window x:Class="SelectiveVpn.FullTunnelPrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource FullTunnel.Title}"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource WindowForeground}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True">
    <Border Margin="20" Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
            CornerRadius="12" Padding="18">
        <StackPanel>
            <TextBlock Text="{DynamicResource FullTunnel.Heading}" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedForeground}"
                       Text="{DynamicResource FullTunnel.Hint}"/>
            <CheckBox x:Name="RememberBox" Margin="0,16,0,0" Content="{DynamicResource FullTunnel.Remember}"
                      Foreground="{DynamicResource WindowForeground}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="{DynamicResource Ui.Cancel}" MinWidth="96" Margin="0,0,8,0" Padding="12,7" Click="CancelClick"
                        Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource ButtonForeground}"
                        BorderBrush="{DynamicResource ButtonBorder}"/>
                <Button Content="{DynamicResource Ui.Continue}" MinWidth="120" Padding="12,7" Click="ContinueClick" IsDefault="True"
                        Background="{DynamicResource PrimaryBackground}" Foreground="{DynamicResource PrimaryForeground}"
                        BorderBrush="{DynamicResource PrimaryBorder}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
