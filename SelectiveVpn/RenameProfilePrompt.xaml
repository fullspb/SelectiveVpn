<Window x:Class="SelectiveVpn.RenameProfilePrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource RenameProfile.Title}"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource WindowForeground}"
        FontFamily="{DynamicResource ThemeFontFamily}"
        UseLayoutRounding="True">
    <Border Style="{StaticResource OrbitDialogSurface}" Margin="20" Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
            CornerRadius="{DynamicResource DialogCornerRadius}" Padding="18">
        <StackPanel>
            <TextBlock Style="{StaticResource OrbitDialogHeading}" Text="{DynamicResource RenameProfile.Heading}" FontSize="16" FontWeight="SemiBold"/>
            <TextBox x:Name="NameBox" Style="{StaticResource OrbitTextBox}" Margin="0,12,0,0" MaxLength="60"
                     AutomationProperties.Name="{DynamicResource RenameProfile.Heading}"/>
            <TextBlock x:Name="HintText" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="11.5"
                       Foreground="{DynamicResource MutedForeground}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="{DynamicResource Ui.Cancel}" MinWidth="96" Margin="0,0,8,0"
                        Style="{StaticResource OrbitButton}" Click="CancelClick" IsCancel="True"/>
                <Button x:Name="SaveButton" Content="{DynamicResource Ui.Save}" MinWidth="120"
                        Style="{StaticResource OrbitPrimaryButton}" Click="SaveClick" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
