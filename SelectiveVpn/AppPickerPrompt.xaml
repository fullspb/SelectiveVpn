<Window x:Class="SelectiveVpn.AppPickerPrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AppPicker.Title}"
        Width="640"
        MinWidth="520"
        MinHeight="480"
        Height="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource WindowForeground}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FieldBackground}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FieldBorder}"/>
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                                <Setter Property="Foreground" Value="{DynamicResource MutedForeground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryDialogButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background" Value="{DynamicResource PrimaryBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBorder}"/>
        </Style>
    </Window.Resources>
    <Border Margin="16" Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
            CornerRadius="12" Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{DynamicResource AppPicker.Heading}" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Grid.Row="1" Margin="0,8,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedForeground}"
                       Text="{DynamicResource AppPicker.Hint}"/>

            <Grid Grid.Row="2" Margin="0,14,0,0">
                <TextBox x:Name="SearchBox" Padding="10,8"
                         Background="{DynamicResource FieldBackground}"
                         Foreground="{DynamicResource WindowForeground}"
                         BorderBrush="{DynamicResource FieldBorder}"
                         CaretBrush="{DynamicResource WindowForeground}"
                         TextChanged="SearchBox_OnTextChanged"/>
                <TextBlock x:Name="SearchHint" Text="{DynamicResource Ui.Search}" Margin="12,0,0,0"
                           Foreground="{DynamicResource MutedForeground}"
                           VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>

            <Grid Grid.Row="3" Margin="0,10,0,0">
                <ListBox x:Name="AppList"
                         Background="{DynamicResource FieldBackground}"
                         Foreground="{DynamicResource WindowForeground}"
                         BorderBrush="{DynamicResource FieldBorder}"
                         BorderThickness="1"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="AppList_OnMouseDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="8,6"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding DetailText}" FontSize="11" Margin="0,2,0,0"
                                           Foreground="{DynamicResource MutedForeground}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText" Text="{DynamicResource Msg.AppsLoading}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedForeground}"
                           IsHitTestVisible="False"/>
            </Grid>

            <TextBlock x:Name="StatusText" Grid.Row="4" Margin="0,10,0,0" FontSize="12"
                       Foreground="{DynamicResource MutedForeground}" Visibility="Collapsed"/>

            <DockPanel Grid.Row="5" Margin="0,14,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="{DynamicResource Ui.AddExe}" MinWidth="120"
                        Style="{StaticResource DialogButton}"
                        Click="BrowseExeClick"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{DynamicResource Ui.Cancel}" MinWidth="96" Margin="0,0,8,0"
                            Style="{StaticResource DialogButton}"
                            Click="CancelClick" IsCancel="True"/>
                    <Button x:Name="AddButton" Content="{DynamicResource Ui.Add}" MinWidth="120"
                            Style="{StaticResource PrimaryDialogButton}"
                            Click="AddClick" IsDefault="True"/>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
