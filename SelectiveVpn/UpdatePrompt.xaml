<Window x:Class="SelectiveVpn.UpdatePrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Update.Title}"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource WindowForeground}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True">
    <Border Margin="20" Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
            CornerRadius="12" Padding="18">
        <StackPanel>
            <TextBlock x:Name="HeadingText" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock x:Name="VersionText" Margin="0,10,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedForeground}"/>
            <TextBlock x:Name="StatusText" Margin="0,14,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedForeground}"/>
            <ProgressBar x:Name="ProgressBar" Margin="0,10,0,0" Height="10" Minimum="0" Maximum="100"
                         Visibility="Collapsed"/>
            <TextBlock x:Name="PercentText" Margin="0,4,0,0" FontSize="12"
                       Foreground="{DynamicResource MutedForeground}" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="CancelButton" Content="{DynamicResource Ui.Cancel}" MinWidth="96" Margin="0,0,8,0"
                        Padding="12,7" Click="CancelClick" IsCancel="True"
                        Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource ButtonForeground}"
                        BorderBrush="{DynamicResource ButtonBorder}"/>
                <Button x:Name="DownloadButton" Content="{DynamicResource Update.Download}" MinWidth="120"
                        Padding="12,7" Click="DownloadClick" IsDefault="True"
                        Background="{DynamicResource PrimaryBackground}" Foreground="{DynamicResource PrimaryForeground}"
                        BorderBrush="{DynamicResource PrimaryBorder}"/>
                <Button x:Name="InstallButton" Content="{DynamicResource Update.Install}" MinWidth="120"
                        Padding="12,7" Click="InstallClick" Visibility="Collapsed"
                        Background="{DynamicResource PrimaryBackground}" Foreground="{DynamicResource PrimaryForeground}"
                        BorderBrush="{DynamicResource PrimaryBorder}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
