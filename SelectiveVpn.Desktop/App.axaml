<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SelectiveVpn.Desktop.ViewModels"
             x:Class="SelectiveVpn.Desktop.App"
             x:DataType="vm:MainViewModel"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://SelectiveVpn.Desktop/Resources/OrbitTheme.axaml"/>
        <ResourceInclude Source="avares://SelectiveVpn.Desktop/Resources/OrbitIcons.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource WindowBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
      <Setter Property="FontFamily" Value="{DynamicResource ThemeFontFamily}"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{DynamicResource FieldBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource FieldBorder}"/>
      <Setter Property="CornerRadius" Value="9"/>
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
    </Style>
  </Application.Styles>

  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon Icon="/Assets/SelectiveVpn.ico"
                ToolTipText="{Binding ConnectionStatusTitle}"
                Command="{Binding ShowWindowCommand}">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="{Binding TrayShowText}" Command="{Binding ShowWindowCommand}" />
            <NativeMenuItem Header="{Binding ConnectionActionText}" Command="{Binding ConnectionActionCommand}" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="{Binding ApplyCapsText}" Command="{Binding ApplyCapabilitiesCommand}" />
            <NativeMenuItem Header="{Binding TeardownText}" Command="{Binding EmergencyTeardownCommand}" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="{Binding TrayQuitText}" Command="{Binding ExitCommand}" />
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>
</Application>
