<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SelectiveVpn.Desktop.ViewModels"
        xmlns:models="using:SelectiveVpn.Desktop.Models"
        xmlns:controls="using:SelectiveVpn.Desktop.Controls"
        x:Class="SelectiveVpn.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="SelectiveVPN"
        Icon="/Assets/SelectiveVpn.ico"
        Width="1140" Height="830"
        MinWidth="1140" MinHeight="830"
        MaxWidth="1140" MaxHeight="830"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource WindowForeground}"
        FontFamily="{DynamicResource ThemeFontFamily}">

  <Window.Styles>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedForeground}"/>
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedForeground}"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="TextBlock.empty-hint">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedForeground}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="Border.orbit-glass">
      <Setter Property="Background" Value="{DynamicResource OrbitGlassFill}"/>
      <Setter Property="BorderBrush" Value="#17FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="22"/>
    </Style>
    <Style Selector="Border.orbit-plate">
      <Setter Property="Background" Value="#33080B18"/>
      <Setter Property="CornerRadius" Value="22"/>
      <Setter Property="BoxShadow" Value="{DynamicResource OrbitPlateShadow}"/>
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
      <Setter Property="Background" Value="#0FFFFFFF"/>
      <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1FFFFFFF"/>
    </Style>
    <Style Selector="Button.ghost StackPanel, Button.push StackPanel">
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- Profiles use ItemsControl (no ListBox selection chrome). Rules ListBox stays transparent. -->
    <Style Selector="ListBox.busy ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="PART_ContentPresenter"
                            Background="Transparent"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ListBox.busy ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.busy ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.busy ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.busy ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.profile-hit">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
      <!-- Fluent focus adorner is a sharp blue rect; kill it. -->
      <Setter Property="FocusAdorner" Value="{x:Null}"/>
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            Background="Transparent"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"/>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.profile-hit:focus /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.profile-hit:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.profile-hit:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.profile-hit:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <!-- Clickable Orbit globe: no Fluent PointerOver / focus rect (WPF HeroButton is chrome-free). -->
    <Style Selector="Button.globe-hit">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusAdorner" Value="{x:Null}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            Background="Transparent"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"/>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.globe-hit:focus /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.globe-hit:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.globe-hit:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.globe-hit:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <!-- Soft black shadow only (colored BoxShadow draws a sharp rect behind CornerRadius). -->
    <Style Selector="Border.profile-card">
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="ClipToBounds" Value="True"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="#28FFFFFF"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
      <Setter Property="BoxShadow" Value="0 12 26 0 #A6000000"/>
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0,0" EndPoint="0.9,1">
          <GradientStop Color="#2AFFFFFF" Offset="0"/>
          <GradientStop Color="#14FFFFFF" Offset="0.4"/>
          <GradientStop Color="#08FFFFFF" Offset="1"/>
        </LinearGradientBrush>
      </Setter>
    </Style>
    <Style Selector="Button.profile-hit:pointerover Border.profile-card">
      <Setter Property="BorderBrush" Value="#40FFFFFF"/>
      <Setter Property="BoxShadow" Value="0 14 30 0 #C0000000"/>
    </Style>
    <Style Selector="Border.profile-card.selected">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBright}"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="Background" Value="{DynamicResource ProfileSelectedBackground}"/>
      <Setter Property="BoxShadow" Value="0 14 28 0 #CC000000"/>
    </Style>
    <Style Selector="Border.profile-avatar">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="CornerRadius" Value="11"/>
      <Setter Property="BoxShadow" Value="0 6 14 0 #88000000, inset 0 1 0 0 #55FFFFFF"/>
    </Style>
    <Style Selector="Button.push">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="FontWeight" Value="ExtraBold"/>
      <Setter Property="Height" Value="64"/>
      <Setter Property="Width" Value="260"/>
      <Setter Property="Padding" Value="20,0"/>
      <Setter Property="Background" Value="{DynamicResource PushBackground}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="{DynamicResource PushButtonCornerRadius}"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.icon">
      <Setter Property="Width" Value="30"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="4"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#18FFFFFF"/>
    </Style>
    <Style Selector="Button.mode-card">
      <Setter Property="Foreground" Value="{DynamicResource MutedForeground}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="MinHeight" Value="52"/>
      <Setter Property="Margin" Value="2"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="CornerRadius" Value="11"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.mode-card:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#14FFFFFF"/>
    </Style>
    <Style Selector="Button.mode-card.selected">
      <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
      <Setter Property="Background" Value="{DynamicResource OrbitAccentSoftBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    </Style>
    <Style Selector="Button.linkish">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="ListBox.busy">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0,4,0,0"/>
      <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
    </Style>
    <Style Selector="Path.icon-stroke">
      <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}"/>
      <Setter Property="StrokeThickness" Value="1.8"/>
      <Setter Property="StrokeLineCap" Value="Round"/>
      <Setter Property="StrokeJoin" Value="Round"/>
      <Setter Property="Fill" Value="Transparent"/>
      <Setter Property="Width" Value="16"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="Stretch" Value="Uniform"/>
    </Style>
  </Window.Styles>

  <Grid>
    <Grid IsHitTestVisible="False">
      <Ellipse Width="520" Height="520" Margin="-120,-180,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
               Opacity="0.22" Fill="{DynamicResource Accent}" />
      <Ellipse Width="480" Height="480" Margin="0,-80,-160,0" HorizontalAlignment="Right" VerticalAlignment="Top"
               Opacity="0.14" Fill="{DynamicResource Accent2}" />
    </Grid>

    <Grid Margin="20,0,20,20" RowDefinitions="52,*">
      <!-- Title bar: brand + version hug left (LastChildFill=False like WPF); Journal flush right. -->
      <DockPanel LastChildFill="False" VerticalAlignment="Center">
        <!-- First Right-docked = furthest right (WPF Log placement). -->
        <Button DockPanel.Dock="Right" Classes="ghost" MinHeight="36" Margin="10,0,0,0"
                Command="{Binding ToggleLogCommand}" ToolTip.Tip="{Binding ShowLogTip}">
          <StackPanel Orientation="Horizontal" Spacing="8"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="›_" FontFamily="{DynamicResource ThemeMonoFontFamily}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding LogLabel}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button DockPanel.Dock="Right" Classes="ghost" MinHeight="36" MinWidth="52" Margin="0,0,10,0"
                Content="{Binding LanguageDisplayName}" Command="{Binding CycleLanguageCommand}"
                ToolTip.Tip="{Binding LanguageTip}"/>
        <Button DockPanel.Dock="Right" Classes="ghost" MinHeight="36" Margin="0,0,10,0"
                Content="{Binding ThemeDisplayName}" Command="{Binding CycleThemeCommand}"
                ToolTip.Tip="{Binding CycleThemeTip}"/>
        <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center"
                    HorizontalAlignment="Left">
          <Viewbox Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center">
            <Path Data="M12,3 L20,6 L20,12 C20,16.5 16.6,20.2 12,21 C7.4,20.2 4,16.5 4,12 L4,6 Z M9,12 L11,14 L15,10"
                  Stroke="{DynamicResource Accent}" StrokeThickness="2" StrokeJoin="Round"
                  StrokeLineCap="Round"/>
          </Viewbox>
          <TextBlock Text="SelectiveVPN" FontWeight="ExtraBold" FontSize="14" VerticalAlignment="Center"/>
          <Border HorizontalAlignment="Left" VerticalAlignment="Center"
                  BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="10"
                  Padding="8,1" Margin="10,0,0,0">
            <TextBlock Text="{Binding VersionLabel}" FontSize="11"
                       Foreground="{DynamicResource MutedForeground}"/>
          </Border>
        </StackPanel>
      </DockPanel>

      <Grid Grid.Row="1" ColumnDefinitions="240,*,360">
        <!-- Profiles (empty state matches WPF: header + list + single Add profile) -->
        <Panel>
          <Border Classes="orbit-plate"/>
          <Border Classes="orbit-glass" Padding="14,18">
            <DockPanel>
              <DockPanel DockPanel.Dock="Top" Margin="6,0,0,10">
                <Button DockPanel.Dock="Right" Classes="icon" Content="⋯" FontSize="18"
                        ToolTip.Tip="{Binding ProfileMenuTip}">
                  <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                      <MenuItem Header="{Binding ChooseServerText}" Command="{Binding ManageServersCommand}"
                                IsVisible="{Binding IsSubscriptionProfile}"/>
                      <MenuItem Header="{Binding LinuxToolsText}">
                        <MenuItem Header="{Binding ApplyCapsText}" Command="{Binding ApplyCapabilitiesCommand}"
                                  ToolTip.Tip="{Binding ApplyCapsTip}"/>
                        <MenuItem Header="{Binding TeardownText}" Command="{Binding EmergencyTeardownCommand}"
                                  ToolTip.Tip="{Binding TeardownTip}"/>
                      </MenuItem>
                      <Separator/>
                      <MenuItem Header="{Binding RemoveProfileTip}" Command="{Binding RemoveProfileCommand}"/>
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
                <TextBlock Text="{Binding ProfilesEyebrow}" Classes="eyebrow" VerticalAlignment="Center"/>
              </DockPanel>

              <StackPanel DockPanel.Dock="Bottom" Spacing="8">
                <Button Classes="ghost" HorizontalAlignment="Stretch" ToolTip.Tip="{Binding AddProfileText}">
                  <Button.Flyout>
                    <MenuFlyout Placement="Top">
                      <MenuItem Header="{Binding FromFileText}" Command="{Binding ImportConfigCommand}"/>
                      <MenuItem Header="{Binding ByLinkText}" Command="{Binding ImportSubscriptionCommand}"/>
                    </MenuFlyout>
                  </Button.Flyout>
                  <StackPanel Orientation="Horizontal" Spacing="8"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="＋" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding AddProfileText}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <TextBlock Text="{Binding PrivilegeStatus}" Classes="hint" TextWrapping="Wrap" Margin="4,0,4,0"
                           IsVisible="{Binding !HasProfile}"/>
              </StackPanel>

              <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Profiles}" IsEnabled="{Binding !IsBusy}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:VpnProfileOption">
                      <Button Classes="profile-hit"
                              Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectProfileCommand}"
                              CommandParameter="{Binding}">
                        <Border Classes="profile-card" Classes.selected="{Binding IsActive}">
                          <Grid ColumnDefinitions="34,*,Auto">
                            <Border Classes="profile-avatar" Background="{DynamicResource Accent}">
                              <TextBlock Text="{Binding Initial}" FontWeight="ExtraBold" FontSize="13"
                                         Foreground="{DynamicResource PrimaryForeground}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
                              <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                              <TextBlock Text="{Binding KindLabel}" FontSize="11.5" Foreground="{DynamicResource MutedForeground}"
                                         Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="2" Width="8" Height="8" CornerRadius="4"
                                    VerticalAlignment="Center" Background="{DynamicResource Accent}"
                                    IsVisible="{Binding IsRunning}"
                                    BoxShadow="0 0 10 0 #E67FE3FF"/>
                          </Grid>
                        </Border>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
          </Border>
        </Panel>

        <!-- Connection: eyebrow + status + globe + Connect -->
        <StackPanel Grid.Column="1" Margin="18,0">
          <TextBlock Text="{Binding ConnectionEyebrow}" Classes="eyebrow" HorizontalAlignment="Center" Margin="0,4,0,0"/>
          <TextBlock Text="{Binding ConnectionStatusTitle}" FontSize="30" FontWeight="ExtraBold"
                     HorizontalAlignment="Center" Margin="0,6,0,0"/>
          <TextBlock Text="{Binding ConnectionSubtitle}" FontSize="13" Foreground="{DynamicResource MutedForeground}"
                     HorizontalAlignment="Center" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" MaxWidth="440"
                     IsVisible="{Binding HasProfile}"/>
          <TextBlock Text="{Binding StatusDetail}" Foreground="{DynamicResource DangerForeground}" FontSize="12"
                     TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" Margin="0,6,0,0"
                     IsVisible="{Binding StatusDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

          <Button Classes="globe-hit" HorizontalAlignment="Center"
                  Width="360" Height="320" Margin="0,0,0,0"
                  Command="{Binding ConnectionActionCommand}"
                  ToolTip.Tip="{Binding ConnectionActionText}"
                  AutomationProperties.Name="{Binding ConnectionActionText}">
            <controls:OrbitGlobeHero Width="360" Height="320" StatusKind="{Binding StatusKind}"/>
          </Button>

          <Button Classes="push" HorizontalAlignment="Center"
                  Command="{Binding ConnectionActionCommand}">
            <StackPanel Orientation="Horizontal" Spacing="10"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
              <Path Data="{StaticResource Icon.Power}" Width="18" Height="18" Stretch="Uniform"
                    Stroke="{DynamicResource PrimaryForeground}" StrokeThickness="2.4"
                    StrokeLineCap="Round" Fill="Transparent"
                    VerticalAlignment="Center"/>
              <TextBlock Text="{Binding ConnectionActionText}" VerticalAlignment="Center"
                         FontWeight="ExtraBold" FontSize="17"/>
            </StackPanel>
          </Button>

          <!-- Status chrome -->
          <Panel Margin="0,24,0,0">
            <Border Classes="orbit-plate" CornerRadius="20"/>
            <Border Classes="orbit-glass" CornerRadius="20" Padding="22,18">
              <Grid ColumnDefinitions="*,1,*" RowDefinitions="Auto,1,Auto">
                <Border Grid.Column="1" Grid.RowSpan="3" Background="#17FFFFFF"/>
                <Border Grid.Row="1" Grid.ColumnSpan="3" Background="#17FFFFFF"/>

                <StackPanel Margin="0,0,18,16" Spacing="6">
                  <TextBlock Text="{Binding ServerLabel}" Classes="hint"/>
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="icon"
                            Command="{Binding ManageServersCommand}"
                            IsVisible="{Binding IsSubscriptionProfile}"
                            ToolTip.Tip="{Binding ChooseServerText}">
                      <Path Classes="icon-stroke" Data="{StaticResource Icon.Chevron}"
                            Stroke="{DynamicResource Accent}" Width="12" Height="12"/>
                    </Button>
                    <TextBlock Text="{Binding ConnectedServer}" FontWeight="Bold" FontSize="15"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  </DockPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="18,0,0,16" Spacing="6">
                  <TextBlock Text="{Binding ExternalIpLabel}" Classes="hint"/>
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="icon" Margin="8,-4,0,-4"
                            Command="{Binding RefreshIpCommand}" ToolTip.Tip="{Binding RefreshTip}">
                      <Path Classes="icon-stroke" Data="{StaticResource Icon.Refresh}"
                            Stroke="{DynamicResource WindowForeground}" Width="14" Height="14"/>
                    </Button>
                    <TextBlock Text="{Binding ExternalIp}" FontWeight="Bold" FontSize="15"
                               FontFamily="{DynamicResource ThemeMonoFontFamily}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                  </DockPanel>
                </StackPanel>
                <StackPanel Grid.Row="2" Margin="0,16,18,0" Spacing="4">
                  <TextBlock Text="{Binding DurationLabel}" Classes="hint"/>
                  <TextBlock Text="{Binding ConnectionDuration}" FontWeight="Bold" FontSize="20"
                             FontFamily="{DynamicResource ThemeMonoFontFamily}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2" Margin="18,16,0,0" Spacing="6">
                  <TextBlock Text="{Binding TrafficLabel}" Classes="hint"/>
                  <Grid ColumnDefinitions="*,*" Margin="0,6,0,0">
                    <StackPanel>
                      <TextBlock FontWeight="Bold" FontSize="15" Foreground="{DynamicResource Accent}"
                                 Text="{Binding IncomingTraffic, StringFormat=↓ {0}}"/>
                      <TextBlock Text="{Binding ReceivedLabel}" Classes="hint" FontSize="10.5" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                      <TextBlock FontWeight="Bold" FontSize="15" Foreground="{DynamicResource Accent2}"
                                 Text="{Binding OutgoingTraffic, StringFormat=↑ {0}}"/>
                      <TextBlock Text="{Binding SentLabel}" Classes="hint" FontSize="10.5" Margin="0,2,0,0"/>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Grid>
            </Border>
          </Panel>

          <Button Classes="linkish" HorizontalAlignment="Center" Margin="0,8,0,0"
                  IsVisible="{Binding !HasProfile}" Content="{Binding AddProfileText}">
            <Button.Flyout>
              <MenuFlyout Placement="Bottom">
                <MenuItem Header="{Binding FromFileText}" Command="{Binding ImportConfigCommand}"/>
                <MenuItem Header="{Binding ByLinkText}" Command="{Binding ImportSubscriptionCommand}"/>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>

        <!-- Routing: Two routes + mode cards + list + AddTargets -->
        <Panel Grid.Column="2">
          <Border Classes="orbit-plate"/>
          <Border Classes="orbit-glass" Padding="18">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="{Binding RoutingEyebrow}" Classes="eyebrow"/>
                <TextBlock Text="{Binding RoutingTitle}" FontSize="22" FontWeight="ExtraBold" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding RulesProfileLabel}" Classes="hint" Margin="0,2,0,10"/>

                <Border Background="#40000000" CornerRadius="14" Padding="3">
                  <UniformGrid Columns="2">
                    <Button Classes="mode-card" Classes.selected="{Binding IsIncludeMode}"
                            Command="{Binding SetIncludeModeCommand}">
                      <TextBlock Text="{Binding ModeIncludeLabel}" TextWrapping="Wrap" TextAlignment="Center"/>
                    </Button>
                    <Button Classes="mode-card" Classes.selected="{Binding IsExcludeMode}"
                            Command="{Binding SetExcludeModeCommand}">
                      <TextBlock Text="{Binding ModeExcludeLabel}" TextWrapping="Wrap" TextAlignment="Center"/>
                    </Button>
                  </UniformGrid>
                </Border>

                <DockPanel Margin="4,12,4,4">
                  <TextBlock DockPanel.Dock="Right" Text="{Binding TargetCount}" Classes="hint"/>
                  <TextBlock Text="{Binding ListedRouteLabel}" FontWeight="Bold" FontSize="12.5"
                             Foreground="{DynamicResource Accent}"/>
                </DockPanel>
              </StackPanel>

              <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                <Button Classes="ghost" HorizontalAlignment="Stretch"
                        BorderBrush="{DynamicResource AccentLine}">
                  <Button.Flyout>
                    <MenuFlyout Placement="Top">
                      <MenuItem Header="{Binding AddAppText}" Command="{Binding AddAppCommand}"/>
                      <MenuItem Header="{Binding AddProcessText}" Command="{Binding AddProcessCommand}"/>
                      <MenuItem Header="{Binding AddFolderText}" Command="{Binding AddFolderCommand}"/>
                      <MenuItem Header="{Binding AddListText}" Command="{Binding AddAddressListCommand}"/>
                    </MenuFlyout>
                  </Button.Flyout>
                  <StackPanel Orientation="Horizontal" Spacing="8"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="＋" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding AddTargetsText}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>

                <Border BorderBrush="#17FFFFFF" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,12,0,0">
                  <StackPanel Spacing="10">
                    <DockPanel>
                      <TextBlock Text="{Binding ThroughVpnLabel}" Width="100" FontWeight="Bold" FontSize="12"
                                 Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                      <Border Height="6" CornerRadius="3" Background="{DynamicResource AccentWashStrong}"/>
                    </DockPanel>
                    <DockPanel>
                      <TextBlock Text="{Binding DirectLabel}" Width="100" FontWeight="Bold" FontSize="12"
                                 Foreground="{DynamicResource MutedForeground}" VerticalAlignment="Center"/>
                      <Border Height="6" CornerRadius="3" Background="#12FFFFFF"/>
                    </DockPanel>
                    <TextBlock Text="{Binding RoutingSummary}" Classes="hint" TextWrapping="Wrap" Margin="0,2,0,0"/>
                  </StackPanel>
                </Border>
              </StackPanel>

              <Panel Margin="0,0,0,8">
                <ListBox Classes="busy"
                         ItemsSource="{Binding RouteTargets}"
                         SelectedItem="{Binding SelectedTarget}"
                         IsEnabled="{Binding !IsBusy}"
                         IsVisible="{Binding HasRules}"
                         FontSize="13">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:RouteRuleItem">
                      <Border CornerRadius="12" Padding="10,8" Background="Transparent">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                          <Border Width="32" Height="32" CornerRadius="10"
                                  Background="{DynamicResource AccentWash}"
                                  BorderBrush="{DynamicResource AccentLine}" BorderThickness="1">
                            <Path Width="15" Height="15" Stretch="Uniform"
                                  Stroke="{DynamicResource Accent}" StrokeThickness="1.6"
                                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                  Data="{Binding IconData}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                          <StackPanel Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13.5"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Classes="hint" FontSize="11.5" TextTrimming="CharacterEllipsis">
                              <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} · {1}">
                                  <Binding Path="KindLabel"/>
                                  <Binding Path="Detail"/>
                                </MultiBinding>
                              </TextBlock.Text>
                            </TextBlock>
                          </StackPanel>
                          <Button Grid.Column="2" Classes="icon" Content="✎" FontSize="13"
                                  Width="34" Height="34" Margin="0,0,2,0"
                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).EditAddressListCommand}"
                                  CommandParameter="{Binding}"
                                  ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).EditRuleTip}"
                                  IsVisible="{Binding IsAddressList}"/>
                          <Button Grid.Column="3" Classes="icon" Content="×" FontSize="17"
                                  Width="34" Height="34"
                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RemoveTargetCommand}"
                                  CommandParameter="{Binding}"
                                  ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).RemoveRuleTip}"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{Binding EmptyRulesText}" Classes="empty-hint" Margin="4,8,4,0"
                           VerticalAlignment="Top" IsVisible="{Binding !HasRules}"/>
              </Panel>
            </DockPanel>
          </Border>
        </Panel>
      </Grid>
    </Grid>

    <Border VerticalAlignment="Bottom" Height="200" Margin="40,0,40,24" Padding="20,12"
            CornerRadius="{DynamicResource CardCornerRadius}"
            Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
            IsVisible="{Binding IsLogVisible}" ZIndex="20">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <Button DockPanel.Dock="Right" Classes="icon" Content="×" FontSize="16"
                  Command="{Binding ToggleLogCommand}" ToolTip.Tip="{Binding HideLogTip}"/>
          <TextBlock Text="{Binding LogLabel}" FontWeight="Bold" VerticalAlignment="Center"/>
        </DockPanel>
        <ListBox ItemsSource="{Binding LogEntries}"
                 Background="Transparent" BorderThickness="0"
                 FontFamily="{DynamicResource ThemeMonoFontFamily}" FontSize="11"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
