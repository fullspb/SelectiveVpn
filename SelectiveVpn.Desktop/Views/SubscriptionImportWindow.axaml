<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SelectiveVpn.Desktop.Views.SubscriptionImportWindow"
        Title="Import subscription"
        Width="560" Height="420"
        MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource WindowForeground}"
        FontFamily="{DynamicResource ThemeFontFamily}">
  <Window.Styles>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedForeground}"/>
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
      <Setter Property="Background" Value="#0FFFFFFF"/>
      <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style Selector="Button.push">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
      <Setter Property="Background" Value="{DynamicResource PushBackground}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontWeight" Value="ExtraBold"/>
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="Padding" Value="18,0"/>
      <Setter Property="CornerRadius" Value="{DynamicResource PushButtonCornerRadius}"/>
    </Style>
  </Window.Styles>
  <DockPanel Margin="22">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,14">
      <TextBlock Text="Import by link or file" FontSize="20" FontWeight="ExtraBold"/>
      <TextBlock Classes="hint" TextWrapping="Wrap"
                 Text="Paste an https subscription URL, vless/vmess/trojan/ss links (one per line), or load a file."/>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,14,0,0">
      <TextBlock Name="StatusText" Classes="hint" TextWrapping="Wrap" IsVisible="False"/>
      <TextBlock Name="ErrorText" Foreground="{DynamicResource DangerForeground}" TextWrapping="Wrap" IsVisible="False"/>
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="ghost" MinWidth="100" Content="Cancel" Name="CancelButton" Click="CancelClick" Margin="8,0,0,0"/>
        <Button DockPanel.Dock="Right" Classes="push" MinWidth="120" Content="Import" Name="ImportButton" Click="ImportClick"/>
        <Button Classes="ghost" Content="From file…" Name="FileButton" Click="FileClick"/>
      </DockPanel>
    </StackPanel>

    <StackPanel Spacing="10">
      <TextBlock Text="Display name (optional)" Classes="hint"/>
      <TextBox Name="NameBox" Watermark="My subscription"/>
      <TextBlock Text="URL or server links" Classes="hint"/>
      <TextBox Name="UrlBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="160"
               Watermark="https://… or vless://…"/>
    </StackPanel>
  </DockPanel>
</Window>
