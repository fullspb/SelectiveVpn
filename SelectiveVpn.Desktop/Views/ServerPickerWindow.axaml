<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:SelectiveVpn.Models"
        x:Class="SelectiveVpn.Desktop.Views.ServerPickerWindow"
        Title="Choose server"
        Width="520" Height="560"
        MinWidth="420" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource WindowForeground}"
        FontFamily="{DynamicResource ThemeFontFamily}">
  <Window.Styles>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedForeground}"/>
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
      <Setter Property="Background" Value="#0FFFFFFF"/>
      <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style Selector="Button.push">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
      <Setter Property="Background" Value="{DynamicResource PushBackground}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontWeight" Value="ExtraBold"/>
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="Padding" Value="18,0"/>
      <Setter Property="CornerRadius" Value="{DynamicResource PushButtonCornerRadius}"/>
    </Style>
  </Window.Styles>
  <DockPanel Margin="20">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
        <Button Classes="ghost" MinHeight="36" Content="Refresh" Name="RefreshButton" Click="RefreshClick"/>
        <Button Classes="ghost" MinHeight="36" Content="Ping" Name="PingButton" Click="PingClick"/>
      </StackPanel>
      <StackPanel Spacing="4">
        <TextBlock Text="Servers" FontSize="20" FontWeight="ExtraBold"/>
        <TextBlock Classes="hint" Text="Pick a node for this subscription profile."/>
      </StackPanel>
    </DockPanel>

    <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,12,0,0">
      <TextBlock Name="StatusText" Classes="hint" TextWrapping="Wrap"/>
      <TextBlock Name="ErrorText" Foreground="{DynamicResource DangerForeground}" TextWrapping="Wrap" IsVisible="False"/>
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="ghost" MinWidth="100" Content="Cancel" Click="CancelClick" Margin="8,0,0,0"/>
        <Button DockPanel.Dock="Right" Classes="push" MinWidth="120" Content="Select" Click="SelectClick"/>
        <Button Classes="ghost" Content="Name ▾" Name="NameHeaderButton" Click="SortByNameClick"/>
        <Button Classes="ghost" Content="Delay" Name="DelayHeaderButton" Click="SortByDelayClick" Margin="8,0,0,0"/>
      </DockPanel>
    </StackPanel>

    <ListBox Name="ServerList" Classes="busy" DoubleTapped="ServerList_OnDoubleTapped">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="models:VpnNodeInfo">
          <DockPanel Margin="6,8">
            <TextBlock DockPanel.Dock="Right" Text="{Binding DelayText}"
                       FontFamily="{DynamicResource ThemeMonoFontFamily}"
                       Foreground="{DynamicResource MutedForeground}" Margin="12,0,0,0"/>
            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="13.5"
                       TextTrimming="CharacterEllipsis"/>
          </DockPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
