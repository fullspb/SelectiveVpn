<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SelectiveVpn.Desktop.Views.AddressListWindow"
        Title="Address list"
        Width="520" Height="420"
        MinWidth="440" MinHeight="340"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource WindowForeground}"
        FontFamily="{DynamicResource ThemeFontFamily}">
  <Window.Styles>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedForeground}"/>
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
      <Setter Property="Background" Value="#0FFFFFFF"/>
      <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.push">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
      <Setter Property="Background" Value="{DynamicResource PushBackground}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontWeight" Value="ExtraBold"/>
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="Padding" Value="18,0"/>
      <Setter Property="CornerRadius" Value="{DynamicResource PushButtonCornerRadius}"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.preset">
      <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
      <Setter Property="Background" Value="{DynamicResource AccentWash}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentLine}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
  </Window.Styles>
  <DockPanel Margin="22">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,10">
      <TextBlock Name="TitleText" FontSize="20" FontWeight="ExtraBold"/>
      <TextBlock Name="HintText" Classes="hint" TextWrapping="Wrap"/>
    </StackPanel>

    <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <Button DockPanel.Dock="Right" Classes="ghost" MinWidth="100" Name="CancelButton" Click="CancelClick" Margin="8,0,0,0"/>
      <Button DockPanel.Dock="Right" Classes="push" MinWidth="120" Name="AddButton" Click="AddClick"/>
      <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock Name="StatusText" Classes="hint" TextWrapping="Wrap"/>
        <TextBlock Name="ErrorText" Classes="hint" Foreground="{DynamicResource DangerForeground}" TextWrapping="Wrap"/>
      </StackPanel>
    </DockPanel>

    <DockPanel>
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
        <Button DockPanel.Dock="Right" Classes="preset" Name="YouTubePresetButton"
                Click="YouTubePresetClick" Margin="8,0,0,0"/>
        <TextBlock Name="AddressesLabel" Classes="hint" VerticalAlignment="Center"/>
      </DockPanel>
      <TextBlock DockPanel.Dock="Bottom" Name="LineCountText" Classes="hint" Margin="0,6,0,0"
                 HorizontalAlignment="Right"/>
      <TextBox Name="AddressBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="200"
               Watermark="example.com"/>
    </DockPanel>
  </DockPanel>
</Window>
