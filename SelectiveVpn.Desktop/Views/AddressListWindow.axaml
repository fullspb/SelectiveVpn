<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SelectiveVpn.Desktop.Views.AddressListWindow"
        Title="Address list"
        Width="520" Height="480"
        MinWidth="440" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource WindowForeground}"
        FontFamily="{DynamicResource ThemeFontFamily}">
  <Window.Styles>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedForeground}"/>
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
      <Setter Property="Background" Value="#0FFFFFFF"/>
      <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.push">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
      <Setter Property="Background" Value="{DynamicResource PushBackground}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontWeight" Value="ExtraBold"/>
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="Padding" Value="18,0"/>
      <Setter Property="CornerRadius" Value="{DynamicResource PushButtonCornerRadius}"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.preset">
      <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
      <Setter Property="Background" Value="{DynamicResource AccentWash}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentLine}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
  </Window.Styles>

  <!-- Grid rows keep preset + line count outside the addresses field (WPF parity). -->
  <Grid Margin="22" RowDefinitions="Auto,*,Auto" RowSpacing="14">
    <StackPanel Grid.Row="0" Spacing="6">
      <TextBlock Name="TitleText" FontSize="20" FontWeight="ExtraBold"/>
      <TextBlock Name="HintText" Classes="hint" TextWrapping="Wrap"/>
    </StackPanel>

    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
      <StackPanel Grid.Row="0" Spacing="4">
        <TextBlock Name="NameLabel" Classes="hint"/>
        <TextBox Name="NameBox" MinHeight="36"/>
      </StackPanel>

      <!-- Preset sits fully above the TextBox, same row as «Адреса» label. -->
      <DockPanel Grid.Row="1" LastChildFill="True">
        <Button DockPanel.Dock="Right" Classes="preset" Name="YouTubePresetButton"
                Click="YouTubePresetClick" Margin="10,0,0,0"
                VerticalAlignment="Center"/>
        <TextBlock Name="AddressesLabel" Classes="hint" VerticalAlignment="Center"/>
      </DockPanel>

      <TextBox Grid.Row="2" Name="AddressBox"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               MinHeight="160"
               VerticalContentAlignment="Top"
               Watermark="example.com"/>

      <!-- Count fully below the box, not clipped by its border. -->
      <TextBlock Grid.Row="3" Name="LineCountText" Classes="hint"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Center"
                 Margin="0,2,0,0"/>
    </Grid>

    <DockPanel Grid.Row="2" LastChildFill="True">
      <Button DockPanel.Dock="Right" Classes="ghost" MinWidth="100" Name="CancelButton"
              Click="CancelClick" Margin="8,0,0,0"/>
      <Button DockPanel.Dock="Right" Classes="push" MinWidth="120" Name="AddButton"
              Click="AddClick" Margin="0,0,0,0"/>
      <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
        <TextBlock Name="StatusText" Classes="hint" TextWrapping="Wrap"/>
        <TextBlock Name="ErrorText" Classes="hint" Foreground="{DynamicResource DangerForeground}"
                   TextWrapping="Wrap"/>
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
